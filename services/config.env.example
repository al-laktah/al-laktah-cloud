# Copy to config.env (git-ignored) and fill in. Read by deploy.sh: the DEPLOY_*
# settings are for deploy.sh itself, every other one is passed to each stack.
DEPLOY_HOST=ubuntu@cloud.example.com # or a Host alias from ~/.ssh/config
DEPLOY_SSH_KEY=~/.ssh/id_ed25519     # private key, YubiKey handle, or the .pub of an agent-held key; empty = ssh defaults
DEPLOY_HOST_WATCHTOWER=ubuntu@watchtower.example.com # services/watchtower goes to the watchtower VM
DEPLOY_HOST_NETBIRD=ubuntu@netbird.example.com       # services/netbird goes to the NetBird VM
DOMAIN=example.com                   # services live at <name>.<DOMAIN>

# Backups (services/backup): copy these from `terraform output -raw services_config`.
OCI_NAMESPACE=abcdefghijkl
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..aaaaaaaa...
BACKUP_BUCKET=backups
BACKUP_PING_URL= # optional: a healthchecks.io ping URL, to be alerted when backups stop
NETBIRD_BACKUP_BUCKET=netbird-backups # the NetBird VM's own bucket (services/netbird)

# Watchtower (services/watchtower)
MAIN_VM_PRIVATE_IP=10.0.1.2 # from `terraform output -raw services_config`: checks the VPN-only sites across the VCN
WATCHTOWER_PRIVATE_IP=10.0.1.3 # from the same output: Homepage's Gatus widget reads Gatus there
WATCHTOWER_PING_URL= # recommended: a healthchecks.io ping URL, so you hear about it if the watchtower itself goes quiet
