# Copy to config.env (git-ignored) and fill in. Read by deploy.sh: the DEPLOY_*
# settings are for deploy.sh itself, every other one is passed to each stack.
DEPLOY_HOST=ubuntu@cloud.example.com # or a Host alias from ~/.ssh/config
DEPLOY_SSH_KEY=~/.ssh/id_ed25519     # private key, YubiKey handle, or the .pub of an agent-held key; empty = ssh defaults
DOMAIN=example.com                   # services live at <name>.<DOMAIN>

# Backups (services/backup): copy these from `terraform output -raw backup_config`.
OCI_NAMESPACE=abcdefghijkl
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..aaaaaaaa...
BACKUP_BUCKET=backups
BACKUP_PING_URL= # optional: a healthchecks.io ping URL, to be alerted when backups stop
