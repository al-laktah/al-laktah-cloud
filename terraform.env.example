# Copy to terraform.env (which is git-ignored) and point it at your own 1Password item:
#   cp terraform.env.example terraform.env
#
# Then run Terraform through 1Password, which fills in the token for that one command:
#   op run --env-file=terraform.env -- terraform plan -out=tfplan
#
# The value is a reference to the secret, not the secret itself.

CLOUDFLARE_API_TOKEN="op://Private/Cloudflare/credential"
